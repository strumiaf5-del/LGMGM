# LGMDM .env.example — template SIN secretos reales. Copiá este archivo a
# .env (o exportá en tu entorno) y completá SOLO los valores reales acá.
# NUNCA commitees .env con secretos reales; usá este template.

# ── IA (Laia / Gemini) ─────────────────────────────────────────────────────
# Se consigue gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme_por_tu_api_key_real
# Opcional: modelo a usar para el asistente (por defecto gemini-2.5-flash)
AI_ASSISTANT_MODEL=gemini-2.5-flash

# ── Seguridad / Auth ───────────────────────────────────────────────────────
# Clave de firma JWT para /auth/login y WebSockets. Rota cada 90 días.
JWT_SECRET=changeme_por_un_hex_de_64_chars_aleatorio
# Admin que se bootstrapa en el arranque (bootstrap_admin)
ADMIN_EMAIL=changeme_por_email_admin_real
ADMIN_PASSWORD=changeme_por_password_admin_real

# ── CORS / Frontend ────────────────────────────────────────────────────────
# Origen del frontend served (same-origin; local queda 127.0.0.1:8000)
FRONTEND_ORIGIN=https://masteringstudio.duckdns.org
# Lista de origenes CORS separados por coma (default = FRONTEND_ORIGIN)
CORS_ORIGINS=

# ── DoS / Tamaño de archivos ───────────────────────────────────────────────
# Máximo de archivo subido en bytes (default 300MB = 300*1024*1024)
MAX_FILE_SIZE=300

# ── Rutas de datos (D-4: en Docker se montan como /app/...) ────────────────
# Carpeta de uploads con TTL (default "uploads", relativa al cwd)
UPLOAD_DIR=uploads
# Carpeta de masters procesados con TTL (default "processed")
PROCESSED_DIR=processed
# Subcarpeta por job con los 4 WAV de stems (default "processed_stems")
STEMS_DIR=processed_stems
# TTL de PROCESSED_DIR/STEMS_DIR en segundos (default 3600)
PROCESSED_TTL=3600
# Librería de referencias (default "reference_library")
REFERENCE_LIBRARY_DIR=reference_library
# Librería de stems del mixer (default "stem_library")
STEM_LIBRARY_DIR=stem_library
# Snapshots de preview en vivo (default "preview_sources")
PREVIEW_DIR=preview_sources
# TTL de preview en segundos (default 3600)
PREVIEW_TTL=3600